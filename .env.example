# ==============================================================================
# O-ZENITH Environment Configuration Template
# Copy this file to .env.local to configure local development settings.
# ==============================================================================

# Google OAuth Client ID (Optional)
# Enables 1-click Google Sign-in and Google Drive backup synchronization.
# Obtain from the Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173
# Authorized Redirect URIs: http://localhost:5173/dashboard/profile
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Provider API Keys (Optional)
# Note: O-ZENITH is designed with Bring-Your-Own-Key (BYOK) privacy architecture.
# Users can securely enter their own API keys directly inside the application UI
# (Account -> API Keys) for OpenAI, Anthropic Claude, Google Gemini, Groq,
# OpenRouter, and DeepSeek. Keys remain encrypted locally in browser storage.

